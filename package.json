    "autoprefixer": "^10.3.1",
    "sass": "^1.49.9",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^8.3.1",
    "postcss": "^8.3.1",
    "express": "4.21.2",
    "path": "0.12.7"
  }
}
